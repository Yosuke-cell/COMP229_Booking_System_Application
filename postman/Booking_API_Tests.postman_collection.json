{
  "info": {
    "name": "Booking API - Error Handling Tests",
    "description": "Run the whole collection with the Collection Runner (top to bottom). Setup creates two users (A and B) and one booking for A, and saves tokens and IDs automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "tokenA",
      "value": ""
    },
    {
      "key": "tokenB",
      "value": ""
    },
    {
      "key": "userAId",
      "value": ""
    },
    {
      "key": "userBId",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Setup",
      "item": [
        {
          "name": "Sign up User A",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"UserA\",\n  \"lastName\": \"Test\",\n  \"email\": \"a{{runId}}@test.com\",\n  \"password\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.collectionVariables.set(\"userAId\", pm.response.json().data.id);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// new emails and cat name every run, so the tests can be run again",
                  "pm.collectionVariables.set(\"runId\", Date.now());"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign up User B",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
