                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/bookings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Playtime with Mochi\",\n  \"catName\": \"Mochi {{runId}}\",\n  \"startDate\": \"2026-12-01T10:00:00\",\n  \"endDate\": \"2026-12-01T12:00:00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
